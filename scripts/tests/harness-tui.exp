#!/usr/bin/expect -f
set timeout 30
set engine [file normalize [file join [file dirname [info script]] "../.."]]
set repo [exec node --input-type=module -e "import { createTuiFixture } from '$engine/scripts/tests/web-fixture.mjs'; console.log(createTuiFixture());"]
set extension [file join $engine "adapters/pi/extensions/harness-manager.ts"]
set readiness [file join $repo "harness-tui-ready.ts"]
set ready_file [open $readiness w]
puts $ready_file {export default function(pi) { pi.on("session_start", (_event, ctx) => ctx.ui.notify("HARNESS_TUI_READY", "info")); }}
close $ready_file
set profile heavy
set keep_log [expr {$argc > 0}]
set output [expr {$keep_log ? [lindex $argv 0] : [file join "/tmp" "harness-tui-smoke-[pid]-[clock clicks].log"]}]
log_file -a -noappend $output
log_user 0

proc await_text {text} {
	expect {
		-exact $text {}
		timeout { puts stderr "TUI smoke: expected text missing: $text"; exit 1 }
		eof { puts stderr "TUI smoke: Pi exited before: $text"; exit 1 }
	}
}

proc await_frame {} {
	await_text "\033\[?2026l"
}

proc await_ready {} {
	expect {
		-exact "HARNESS_TUI_READY" {}
		timeout { puts stderr "TUI smoke: initial render missing"; exit 1 }
		eof { puts stderr "TUI smoke: Pi exited during startup"; exit 1 }
	}
}

spawn env TERM=xterm-256color PI_OFFLINE=1 HARNESS_CATALOG=$repo pi --no-extensions --extension $extension --extension $readiness --no-skills --no-session --offline
await_ready
await_frame
send -- "/harness\r"
expect {
	-exact "Harness 管理面" {}
	timeout { puts stderr "TUI smoke: main menu missing"; exit 1 }
}
await_text "逐项启停 repository 词条、选择详略、预览和编辑源码"
await_frame
send -- "\033\[B\r"
expect {
	-exact "AGENTS.md 常驻词条" {}
	timeout { puts stderr "TUI smoke: instruction menu missing"; exit 1 }
}
await_text "每项可选精简、标准或详细说明"
await_frame
send -- "\r"
expect {
	-exact "AGENTS.md 词条（mandatory 锁定）" {}
	timeout { puts stderr "TUI smoke: entry list missing"; exit 1 }
}
await_text "不可关闭的安全边界"
await_frame
send -- "\033"
await_text "AGENTS.md 常驻词条"
await_frame
send -- "\033"
await_text "Harness 管理面"
await_frame
send -- "\033"
await_frame
send -- "/quit\r"
expect {
	eof {}
	timeout { puts stderr "TUI smoke: Pi did not quit"; exit 1 }
}

spawn env TERM=xterm-256color PI_OFFLINE=1 HARNESS_CATALOG=$repo pi --no-extensions --extension $extension --extension $readiness --no-skills --no-session --offline
stty columns 48 rows 24
await_ready
await_frame
send -- "/harness configure $profile\r"
expect {
	-exact {配置 } {}
	timeout { puts stderr "TUI smoke: profile menu missing"; exit 1 }
}
await_frame
send -- "\033\[B\r"
expect {
	-exact "Skills 开关" {}
	timeout { puts stderr "TUI smoke: skills page missing"; exit 1 }
}
await_text "摘要上限：112 列"
await_frame
send -- "\033"
await_text {配置 }
await_frame
send -- "\033"
await_frame
send -- "/harness skills\r"
expect {
	-exact "Skills 目录（摘要列表）" {}
	timeout { puts stderr "TUI smoke: Skills catalog missing"; exit 1 }
}
await_frame
send -- "\r"
expect {
	-exact "Skill 详情 · agent-browser" {}
	timeout { puts stderr "TUI smoke: long Skill detail missing"; exit 1 }
}
expect {
	-exact "↑↓ 滚动" {}
	timeout { puts stderr "TUI smoke: Skill detail scroll hint missing"; exit 1 }
}
await_frame
send -- "\033"
expect {
	-exact "Skills 目录（摘要列表）" {}
	timeout { puts stderr "TUI smoke: Skill detail did not return"; exit 1 }
}
close
wait
log_file
file delete -force $repo
if {!$keep_log} { file delete -force $output }
puts "harness TUI smoke: OK (including narrow Skill summary/detail view)"
